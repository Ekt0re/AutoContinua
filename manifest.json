{
  "manifest_version": 3,
  "name": "AutoContinua",
  "version": "1.3",
  "description": "Clicca automaticamente i pulsanti \"Continua\" (Click Box).",
  "author": "Ettore Sartori",
  "homepage_url": "https://github.com/Ekt0re/AutoContinua",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}