{
  "manifest_version": 3,
  "name": "AutoContinua",
  "version": "1.7",
  "description": "Clicca automaticamente i pulsanti \"Continua\" (Click Box).",
  "author": "Ettore Sartori",
  "homepage_url": "https://github.com/Ekt0re/AutoContinua",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "file:///*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autocontinua@ettoresartori.example",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}